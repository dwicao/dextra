{
  "manifest_version": 2,
  "name": "Dextra Ad Block",
  "version": "2.4.0",
  "description": "Dextra ad blocking with host, script, and cosmetic rules.",
  "browser_specific_settings": {
    "gecko": {
      "id": "adblock@dextra"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
